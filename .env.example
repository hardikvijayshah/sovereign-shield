# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default

# Bedrock Model (default: Claude Sonnet)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-east-1

# Scan Configuration
SCAN_ACCOUNTS=123456789012,234567890123
SCAN_REGIONS=us-east-1,us-west-2,eu-west-1,eu-central-1,ap-south-1,ap-southeast-1

# DynamoDB Tables (set by CDK on deployment)
REGULATIONS_TABLE=sovereign-shield-regulations
SCAN_RESULTS_TABLE=sovereign-shield-scan-results
VIOLATIONS_TABLE=sovereign-shield-violations

# S3 Bucket for reports
REPORTS_BUCKET=sovereign-shield-reports
